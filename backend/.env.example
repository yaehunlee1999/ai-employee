APP_ENV=development
DATABASE_URL=postgresql://postgres:replace-me@db.example.supabase.co:5432/postgres
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_KEY=replace-with-server-auth-api-key
OPENAI_API_KEY=replace-me
VAPI_PUBLIC_KEY=replace-with-vapi-public-key
VAPI_PRIVATE_KEY=replace-with-vapi-private-key
VAPI_WEBHOOK_SECRET=replace-with-a-long-random-secret
# Include both production domains. Local origins are added automatically when
# APP_ENV is not production.
CORS_ALLOWED_ORIGINS=https://dinebell.app,https://www.dinebell.app
